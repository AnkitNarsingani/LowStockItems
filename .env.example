#-----------------------------------------------------------------------------
# Copy to `.env` for local development. NEVER commit real values.
# In production set these in Netlify → Site configuration → Environment
# variables. Everything here is SERVER-side: none of it is exposed to the
# browser, which is the point of the change.
#-----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Used to build the Zoho redirect URI and invitation links, and to decide
# whether cookies get the Secure attribute. Must be the real origin.
APP_BASE_URL=http://localhost:3000

# Signs session JWTs. 32+ characters. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Session lifetime in seconds (default 43200 = 12h; min 300, max 7 days).
AUTH_SESSION_SECONDS=43200

# One-time token that allows creating the FIRST administrator via
# POST /api/auth/bootstrap. Remove it once that account exists.
BOOTSTRAP_TOKEN=

# --- Database ---------------------------------------------------------------
# Netlify DB (Neon) injects NETLIFY_DATABASE_URL automatically in production.
# DATABASE_URL takes precedence, which lets you point at any Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lowstockitems

# --- Zoho Books -------------------------------------------------------------
# A *Server-based Application* client at https://api-console.zoho.in — NOT the
# self-client / JavaScript client the old implicit-grant flow used. The
# authorized redirect URI must be exactly:
#   <APP_BASE_URL>/api/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Optional. When set it wins over the token stored by Settings → Connect Zoho,
# and disconnecting from the UI is refused. Easier to rotate in an incident.
ZOHO_REFRESH_TOKEN=

# Accounts server for the data centre the Zoho account belongs to.
#   India: https://accounts.zoho.in  |  US: https://accounts.zoho.com
#   EU:    https://accounts.zoho.eu  |  AU: https://accounts.zoho.com.au
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in

# Leave blank to derive from the accounts domain (India → www.zohoapis.in).
ZOHO_API_DOMAIN=

# Forced onto every proxied request, so a caller cannot address another org.
ZOHO_ORGANIZATION_ID=

# Optional: separate key for encrypting the stored Zoho refresh token.
# Falls back to AUTH_JWT_SECRET when unset.
ZOHO_TOKEN_KEY=
